{
  "manifest_version": 3,
  "name": "Fourdock \u00b7 conferma passkey",
  "version": "0.1.0",
  "description": "Conferma manualmente la passkey WhatsApp nel browser per il client Fourdock.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "key": ""
}
