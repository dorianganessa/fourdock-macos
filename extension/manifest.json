{
  "manifest_version": 3,
  "name": "Fourdock",
  "version": "0.2.0",
  "description": "A dedicated four-service workspace using the full browser authentication stack.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging",
    "alarms",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://app.fastmail.com/*",
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Fourdock",
    "default_icon": "icons/fourdock.png"
  },
  "icons": { "128": "icons/fourdock.png" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*", "https://web.telegram.org/*", "https://app.fastmail.com/*", "https://mail.google.com/*"],
      "js": ["notification-page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://app.fastmail.com/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "notification-content.js",
        "sidebar.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "focus-whatsapp": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "MacCtrl+Shift+1"
      },
      "description": "Fourdock: WhatsApp",
      "global": true
    },
    "focus-telegram": {
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "MacCtrl+Shift+2"
      },
      "description": "Fourdock: Telegram",
      "global": true
    },
    "focus-fastmail": {
      "suggested_key": {
        "default": "Ctrl+Shift+3",
        "mac": "MacCtrl+Shift+3"
      },
      "description": "Fourdock: Fastmail",
      "global": true
    },
    "focus-gmail": {
      "suggested_key": {
        "default": "Ctrl+Shift+4",
        "mac": "MacCtrl+Shift+4"
      },
      "description": "Fourdock: Gmail",
      "global": true
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
