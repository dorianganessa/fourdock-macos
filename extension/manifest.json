{
  "manifest_version": 3,
  "name": "Fourdock",
  "version": "0.1.0",
  "description": "A dedicated four-service workspace using the full browser authentication stack.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://app.fastmail.com/*",
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Fourdock"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://app.fastmail.com/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "sidebar.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "service-1": {
      "suggested_key": {
        "default": "Alt+1",
        "mac": "Command+1"
      },
      "description": "Select service 1"
    },
    "service-2": {
      "suggested_key": {
        "default": "Alt+2",
        "mac": "Command+2"
      },
      "description": "Select service 2"
    },
    "service-3": {
      "suggested_key": {
        "default": "Alt+3",
        "mac": "Command+3"
      },
      "description": "Select service 3"
    },
    "service-4": {
      "suggested_key": {
        "default": "Alt+4",
        "mac": "Command+4"
      },
      "description": "Select service 4"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
